# Configurações de ambiente

# Modo de dados
# false = usa login/cadastro/ponto local no celular
# true = usa API configurada abaixo
EXPO_PUBLIC_USE_API=false

# API Base URL, quando EXPO_PUBLIC_USE_API=true.
# Em celular fisico, use o IP da maquina que roda o backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api

# Debug Mode
DEBUG=false

# Dados de Teste
TEST_USER_EMAIL=teste@email.com
TEST_USER_PASSWORD=senha123
